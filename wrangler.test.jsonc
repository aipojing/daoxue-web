{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daoxue-web-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  // 仅测试用固定主密钥，生产必须通过 wrangler secret 注入随机值
  "vars": {
    "AI_SETTINGS_ENCRYPTION_KEY": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daoxue-test-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COURSEWARE_MEDIA",
      "bucket_name": "daoxue-courseware-media-test"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "COURSEWARE_QUEUE",
        "queue": "daoxue-courseware-generation-test"
      }
    ],
    "consumers": [
      {
        "queue": "daoxue-courseware-generation-test",
        "max_batch_size": 1,
        "max_retries": 3
      }
    ]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }]
}
